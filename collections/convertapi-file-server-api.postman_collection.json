          "name": "Upload file",
          "id": "46785f1a-9af3-4b78-bdbc-b5961df05422",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "description": "This header field is used to determine the file name.\n**Required** if query parameter `filename` is not set.\nQuery parameter `filename` overrides this parameter.\n",
                "key": "content-disposition",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "description": "The file to upload",
                  "key": "file",
                  "type": "file",
                  "value": null
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/upload?filename=<string>&fileId=<string>&url=<uri>&headername=<string>&headervalue=<string>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "upload"
              ],
              "query": [
                {
                  "description": "File name.\nRequired if the header field `content-disposition` is not set.\n",
                  "key": "filename",
                  "value": "<string>"
                },
                {
                  "description": "Custom ID for the file that is uploaded. Lowercase alphanumeric character string.",
                  "key": "fileId",
                  "value": "<string>"
                },
                {
                  "description": "Remote file URL. The URL of the file you want to upload and store on the ConvertAPI file server.\nIf the file is accessible by the URL, it can be uploaded directly from its location by passing the URL instead of the file itself.\n",
                  "key": "url",
                  "value": "<uri>"
                },
                {
                  "description": "Remote file request header field name (used exclusively in conjunction with the `url` parameter).",
                  "key": "headername",
                  "value": "<string>"
                },
                {
                  "description": "Remote file request header field value (used exclusively in conjunction with the `url` and `headername` parameters).",
                  "key": "headervalue",
                  "value": "<string>"
                }
              ]
            },
            "description": "When source files require multiple conversions, optimizing performance is possible by uploading the file once and then performing multiple conversions without the need for re-uploading.\nThe uploaded file is securely stored on the convertapi.com server for a maximum period of 3 hours and can be accessed through a unique secret URL with a UUID.\nIn conversion requests, the file can be referenced using the File ID, which is generated upon successful file upload."
          },
